# Exchange
EXCHANGE=binance
TRADING_MODE=paper
PAPER_BALANCE=10000
WATCHLIST=BTC/USDT,ETH/USDT,SOL/USDT

# Anthropic
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Risk parameters (do not change without backtesting)
CONFLUENCE_MIN_SCORE=7
MIN_CONFIDENCE_SCORE=7.0
MAX_POSITION_SIZE_PCT=0.05
RISK_PER_TRADE_PCT=0.01
MAX_DAILY_LOSS_PCT=0.03
ATR_SL_MULTIPLIER=1.5
ATR_TP_MULTIPLIER=3.0
MAX_TRADES_PER_SESSION=10
CORRELATION_LIMIT=0.85

# Infrastructure
UPTIMEROBOT_URL=your_uptimerobot_heartbeat_url_here
