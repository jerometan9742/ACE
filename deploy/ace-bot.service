[Unit]
Description=ACE Intraday Trading Bot
After=network.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=/root/ACE
EnvironmentFile=/root/ACE/.env
ExecStart=/root/ACE/venv/bin/python scheduler.py
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
