//@version=6
strategy("ACE V6 – Full Confluence + ATR Optimized", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=5,
     initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.04)

// ── Inputs ──────────────────────────────────────────────────────────────────
atr_len         = input.int(14,   "ATR Length")
atr_sl_mult     = input.float(1.2, "ATR SL Multiplier", step=0.1)
atr_tp_mult     = input.float(2.4, "ATR TP Multiplier", step=0.1)
confluence_min  = input.int(7,    "Min Confluence Score", minval=1, maxval=10)
vol_ma_len      = input.int(20,   "Volume MA Length")
trail_atr_mult  = input.float(1.0, "Trailing Stop ATR Mult", step=0.1)
use_trail       = input.bool(true, "Use Trailing Stop")

// ── ATR & Volume ─────────────────────────────────────────────────────────────
atr    = ta.atr(atr_len)
vol_ma = ta.sma(volume, vol_ma_len)

// ── Kill Zones (UTC) ─────────────────────────────────────────────────────────
h = hour(time, "UTC")
m = minute(time, "UTC")
london_open  = h >= 7 and h < 9
in_ny_open   = (h == 13 and m >= 30) or h == 14
ny_afternoon = h >= 17 and h < 19
in_kill_zone = london_open or in_ny_open or ny_afternoon

// ── FVG (+2) ─────────────────────────────────────────────────────────────────
bull_fvg = low > high[2]
bear_fvg = high < low[2]

// ── Order Block (+2) ─────────────────────────────────────────────────────────
var float last_bull_ob = na
var float last_bear_ob = na
if close[1] < open[1] and close > high[1]
    last_bull_ob := low[1]
if close[1] > open[1] and close < low[1]
    last_bear_ob := high[1]
near_bull_ob = not na(last_bull_ob) and math.abs(close - last_bull_ob) / close < 0.005
near_bear_ob = not na(last_bear_ob) and math.abs(close - last_bear_ob) / close < 0.005

// ── BOS – Break of Structure (+1) ────────────────────────────────────────────
swing_high = ta.highest(high, 10)[1]
swing_low  = ta.lowest(low, 10)[1]
bull_bos = close > swing_high
bear_bos = close < swing_low

// ── Volume Confirmation (+1) ──────────────────────────────────────────────────
vol_confirm = volume > vol_ma * 1.2

// ── Judas Swing (+2) ─────────────────────────────────────────────────────────
candle_range = high - low
upper_wick   = high - math.max(open, close)
lower_wick   = math.min(open, close) - low
bear_judas   = candle_range > 0 and upper_wick / candle_range >= 0.6 and close < open and vol_confirm
bull_judas   = candle_range > 0 and lower_wick / candle_range >= 0.6 and close > open and vol_confirm

// ── Confluence Scoring ────────────────────────────────────────────────────────
bull_score = (bull_fvg ? 2 : 0) + (near_bull_ob ? 2 : 0) + (in_kill_zone ? 2 : 0) +
             (bull_bos ? 1 : 0) + (vol_confirm ? 1 : 0) + (bull_judas ? 2 : 0)
bear_score = (bear_fvg ? 2 : 0) + (near_bear_ob ? 2 : 0) + (in_kill_zone ? 2 : 0) +
             (bear_bos ? 1 : 0) + (vol_confirm ? 1 : 0) + (bear_judas ? 2 : 0)

bull_signal = bull_score >= confluence_min
bear_signal = bear_score >= confluence_min

// ── Entries with Trailing Stop ────────────────────────────────────────────────
trail_offset = use_trail ? trail_atr_mult * atr : na

if bull_signal
    sl = close - atr_sl_mult * atr
    tp = close + atr_tp_mult * atr
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp, trail_price=use_trail ? close + atr * 0.5 : na, trail_offset=trail_offset)

if bear_signal
    sl = close + atr_sl_mult * atr
    tp = close - atr_tp_mult * atr
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp, trail_price=use_trail ? close - atr * 0.5 : na, trail_offset=trail_offset)

// ── Visuals ──────────────────────────────────────────────────────────────────
bgcolor(in_kill_zone ? color.new(color.yellow, 90) : na, title="Kill Zone")
plotshape(bull_signal, "Bull Opt", shape.triangleup,   location.belowbar, color.lime,   size=size.normal)
plotshape(bear_signal, "Bear Opt", shape.triangledown, location.abovebar, color.orange, size=size.normal)

var table score_tbl = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 70), border_width=1)
if barstate.islast
    table.cell(score_tbl, 0, 0, "Bull Score", text_color=color.white, text_size=size.small)
    table.cell(score_tbl, 1, 0, str.tostring(bull_score) + "/10", text_color=bull_score >= 7 ? color.lime : color.gray, text_size=size.small)
    table.cell(score_tbl, 0, 1, "Bear Score", text_color=color.white, text_size=size.small)
    table.cell(score_tbl, 1, 1, str.tostring(bear_score) + "/10", text_color=bear_score >= 7 ? color.red : color.gray, text_size=size.small)
    table.cell(score_tbl, 0, 2, "SL/TP ATR", text_color=color.white, text_size=size.small)
    table.cell(score_tbl, 1, 2, str.tostring(atr_sl_mult) + "x / " + str.tostring(atr_tp_mult) + "x", text_color=color.yellow, text_size=size.small)
    table.cell(score_tbl, 0, 3, "Trail", text_color=color.white, text_size=size.small)
    table.cell(score_tbl, 1, 3, use_trail ? "ON" : "OFF", text_color=use_trail ? color.lime : color.gray, text_size=size.small)
