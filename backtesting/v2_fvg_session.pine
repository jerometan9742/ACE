//@version=6
strategy("ACE V2 – FVG + Kill Zone", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=5,
     initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.04)

// ── Inputs ──────────────────────────────────────────────────────────────────
atr_len     = input.int(14, "ATR Length")
atr_sl_mult = input.float(1.5, "ATR SL Multiplier")
atr_tp_mult = input.float(3.0, "ATR TP Multiplier")

// ── ATR ──────────────────────────────────────────────────────────────────────
atr = ta.atr(atr_len)

// ── Kill Zones (UTC) ─────────────────────────────────────────────────────────
london_open   = (hour(time, "UTC") >= 7  and hour(time, "UTC") < 9)
ny_open       = (hour(time, "UTC") >= 13 and hour(time, "UTC") < 15) or
                (hour(time, "UTC") == 13 and minute(time, "UTC") >= 30)
ny_afternoon  = (hour(time, "UTC") >= 17 and hour(time, "UTC") < 19)

// Precise NY open: 13:30–15:00 UTC
h = hour(time, "UTC")
m = minute(time, "UTC")
in_ny_open = (h == 13 and m >= 30) or h == 14
in_kill_zone = london_open or in_ny_open or ny_afternoon

// ── FVG Detection ────────────────────────────────────────────────────────────
bull_fvg = low > high[2]
bear_fvg = high < low[2]

// ── Entry: FVG inside kill zone only ─────────────────────────────────────────
if bull_fvg and in_kill_zone
    sl = close - atr_sl_mult * atr
    tp = close + atr_tp_mult * atr
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp)

if bear_fvg and in_kill_zone
    sl = close + atr_sl_mult * atr
    tp = close - atr_tp_mult * atr
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp)

// ── Visuals ──────────────────────────────────────────────────────────────────
bgcolor(in_kill_zone ? color.new(color.yellow, 90) : na, title="Kill Zone")
plotshape(bull_fvg and in_kill_zone, "Bull FVG+KZ", shape.triangleup,   location.belowbar, color.green, size=size.tiny)
plotshape(bear_fvg and in_kill_zone, "Bear FVG+KZ", shape.triangledown, location.abovebar, color.red,   size=size.tiny)
