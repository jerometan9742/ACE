//@version=6
strategy("ACE V3 – FVG + Order Block + Kill Zone", overlay=true,
     default_qty_type=strategy.percent_of_equity, default_qty_value=5,
     initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.04)

// ── Inputs ──────────────────────────────────────────────────────────────────
atr_len     = input.int(14, "ATR Length")
atr_sl_mult = input.float(1.5, "ATR SL Multiplier")
atr_tp_mult = input.float(3.0, "ATR TP Multiplier")
ob_lookback = input.int(10, "Order Block Lookback")

// ── ATR ──────────────────────────────────────────────────────────────────────
atr = ta.atr(atr_len)

// ── Kill Zones (UTC) ─────────────────────────────────────────────────────────
h = hour(time, "UTC")
m = minute(time, "UTC")
london_open  = h >= 7 and h < 9
in_ny_open   = (h == 13 and m >= 30) or h == 14
ny_afternoon = h >= 17 and h < 19
in_kill_zone = london_open or in_ny_open or ny_afternoon

// ── FVG Detection ────────────────────────────────────────────────────────────
bull_fvg = low > high[2]
bear_fvg = high < low[2]

// ── Order Block Detection ─────────────────────────────────────────────────────
// Bullish OB: last bearish candle before price moved up impulsively
// Defined as: bearish candle followed by price breaking above its high
bull_ob = close[1] < open[1] and close > high[1]  // Mitigation of bearish OB
bear_ob = close[1] > open[1] and close < low[1]   // Mitigation of bullish OB

// Track if price is near a recent OB level within lookback
var float last_bull_ob_level = na
var float last_bear_ob_level = na

if bull_ob
    last_bull_ob_level := low[1]
if bear_ob
    last_bear_ob_level := high[1]

near_bull_ob = not na(last_bull_ob_level) and close >= last_bull_ob_level * 0.998 and close <= last_bull_ob_level * 1.005
near_bear_ob = not na(last_bear_ob_level) and close <= last_bear_ob_level * 1.002 and close >= last_bear_ob_level * 0.995

// ── Entry: FVG + OB + Kill Zone ───────────────────────────────────────────────
bull_signal = bull_fvg and near_bull_ob and in_kill_zone
bear_signal = bear_fvg and near_bear_ob and in_kill_zone

if bull_signal
    sl = close - atr_sl_mult * atr
    tp = close + atr_tp_mult * atr
    strategy.entry("Long", strategy.long)
    strategy.exit("Long Exit", "Long", stop=sl, limit=tp)

if bear_signal
    sl = close + atr_sl_mult * atr
    tp = close - atr_tp_mult * atr
    strategy.entry("Short", strategy.short)
    strategy.exit("Short Exit", "Short", stop=sl, limit=tp)

// ── Visuals ──────────────────────────────────────────────────────────────────
bgcolor(in_kill_zone ? color.new(color.yellow, 90) : na, title="Kill Zone")
plotshape(bull_signal, "Bull Signal", shape.triangleup,   location.belowbar, color.lime,   size=size.small)
plotshape(bear_signal, "Bear Signal", shape.triangledown, location.abovebar, color.orange, size=size.small)
